<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-CompeteDesk-a62b44a0-6c1f-4965-9641-8901a7fc2899</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);CompeteDesk.Data/**;CompeteDesk.Domain/**;**/bin/**;**/obj/**;App_Data/**;app.db</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CompeteDesk.Data/**/*.cs" />
    <Compile Remove="CompeteDesk.Domain/**/*.cs" />
    <Compile Remove="**/obj/**/*.cs" />
    <Compile Remove="**/bin/**/*.cs" />
    <Compile Remove="**/*Tests.cs" />
    <EmbeddedResource Remove="CompeteDesk.Data/**" />
    <EmbeddedResource Remove="CompeteDesk.Domain/**" />
    <None Remove="CompeteDesk.Data/**" />
    <None Remove="CompeteDesk.Domain/**" />
    <Content Remove="CompeteDesk.Data/**" />
    <Content Remove="CompeteDesk.Domain/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Email/SMS Providers -->
    <PackageReference Include="SendGrid" Version="9.29.3" />
    <!-- Twilio 7.34.0 is not available on nuget.org anymore; pin to a version that exists -->
    <PackageReference Include="Twilio" Version="7.14.1" />
  </ItemGroup>

</Project>
