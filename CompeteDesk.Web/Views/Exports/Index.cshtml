@model CompeteDesk.Controllers.ExportsController.ExportIndexViewModel
@{
    ViewData["Title"] = "Exports";
    ViewData["UseSidebar"] = true;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="mb-1">Exports</h1>
            <p class="text-muted mb-0">Generate PDF exports for your currently active workspace.</p>
        </div>
        <div class="text-lg-end">
            <div class="small text-uppercase text-muted fw-semibold">@Model.Tier plan</div>
            <div class="fw-semibold">@Model.ExportsUsed / @Model.ExportLimit exports used this month</div>
        </div>
    </div>

    @if (TempData["ExportError"] is string exportError && !string.IsNullOrWhiteSpace(exportError))
    {
        <div class="alert alert-warning" role="alert">@exportError</div>
    }

    @if (!Model.HasWorkspace)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="h5">No workspace selected</h2>
                <p class="text-muted mb-3">Create a workspace first so CompeteDesk knows which data to export.</p>
                <a class="btn btn-primary" asp-controller="Workspaces" asp-action="Create">Create Workspace</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="small text-uppercase text-muted fw-semibold mb-2">Active workspace</div>
                <h2 class="h4 mb-1">@Model.WorkspaceName</h2>
                <p class="text-muted mb-4">Exports use your selected workspace context instead of relying on a raw sidebar link.</p>

                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" asp-controller="Exports" asp-action="CompetencySummaryPdf" asp-route-workspaceId="@Model.WorkspaceId">Competency Summary PDF</a>
                    <a class="btn btn-outline-secondary" asp-controller="Exports" asp-action="ProgressReportPdf" asp-route-workspaceId="@Model.WorkspaceId">Progress Report PDF</a>
                    <a class="btn btn-outline-secondary" asp-controller="Exports" asp-action="StrategiesPdf" asp-route-workspaceId="@Model.WorkspaceId">Strategies PDF</a>
                    <a class="btn btn-outline-secondary" asp-controller="Exports" asp-action="StrategiesExcel" asp-route-workspaceId="@Model.WorkspaceId">Strategies Excel/CSV</a>
                    <a class="btn btn-outline-secondary" asp-controller="Exports" asp-action="MonthlySummaryPdf" asp-route-workspaceId="@Model.WorkspaceId">Monthly Summary PDF</a>
                </div>
                <div class="small text-muted mt-3">Shareable reports can be downloaded and sent as attachments to your team or stakeholders.</div>
            </div>
        </div>
    }
</div>
