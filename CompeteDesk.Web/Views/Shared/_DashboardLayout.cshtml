@{
    // Dashboard wrapper layout:
    // - Uses the main _Layout
    // - Forces sidebar + fluid container unless the page overrides
    Layout = "_Layout";
    ViewData["UseSidebar"] = true;
    ViewData["LayoutFluid"] ??= true;
}

@RenderBody()

@section Styles {
    @RenderSection("Styles", required: false)
}

@section Scripts {
    @RenderSection("Scripts", required: false)
}
