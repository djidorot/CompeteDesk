@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject SignInManager<IdentityUser> SignInManager

@{
    var rawName = User?.Identity?.Name ?? string.Empty;
    var at = rawName.IndexOf('@');
    var displayName = at > 0 ? rawName[..at] : rawName;
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "User";
    }

    var principal = User ?? new ClaimsPrincipal();
    var requestPath = Context?.Request?.Path.Value ?? string.Empty;
    var isLoginPage = requestPath.StartsWith("/Identity/Account/Login", System.StringComparison.OrdinalIgnoreCase);
    var isRegisterPage = requestPath.StartsWith("/Identity/Account/Register", System.StringComparison.OrdinalIgnoreCase);
    var isDashboardPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard";
}

<ul class="navbar-nav align-items-lg-center gap-lg-3">
@if (SignInManager.IsSignedIn(principal))
{
    <li class="nav-item">
        <a class="nav-link cd-navlink @(isDashboardPage ? "is-active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index" title="Open dashboard">Hello @displayName!</a>
    </li>
    <li class="nav-item">
        <a class="nav-link cd-navlink @(isDashboardPage ? "is-active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    </li>
    <li class="nav-item">
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="~/" method="post">
            <button type="submit" class="nav-link cd-navlink btn btn-link p-0 border-0 align-baseline">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link cd-navlink @(isLoginPage ? "is-active" : "")" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
    <li class="nav-item">
        <a class="nav-link cd-navlink @(isRegisterPage ? "is-active" : "")" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
}
</ul>
