@using System.Security.Claims

@{
    var email = User?.FindFirstValue(ClaimTypes.Email)
    ?? User?.FindFirstValue("email")
    ?? User?.Identity?.Name
    ?? "Account";

    var displayName = User?.FindFirstValue(ClaimTypes.Name)
    ?? User?.FindFirstValue("name")
    ?? email;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<aside class="cd-sidebar" data-cd-sidebar>
    <div class="cd-sidebar__top">
        <a class="cd-sidebar__brand" asp-controller="Home" asp-action="Index" aria-label="CompeteDesk home">
            <span class="cd-sidebar__logo" aria-hidden="true">
                <img src="~/images/cd-logo.png" alt="CompeteDesk" style="height:28px;" />
            </span>
            <span class="cd-sidebar__brandText">
                CompeteDesk
                <span class="d-block small" style="opacity:.7; font-weight:500;">Strategic Prep</span>
            </span>
        </a>

        <button class="cd-sidebar__collapseBtn" type="button" data-cd-sidebar-collapse aria-label="Collapse sidebar">
            <span class="cd-sidebar__collapseIco" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-ico" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 18l-6-6 6-6"></path>
                </svg>
            </span>
        </button>
    </div>

    @* NOTE: Removed sidebar search to avoid duplicate search UI (topbar already has search). *@

    @if (User?.IsInRole("ReadOnly") != true)
    {
        <div class="cd-sidebar__cta">
            <a class="cd-btn cd-btn--primary cd-btn--block" asp-controller="Workspaces" asp-action="Create">
                <span class="cd-btn__ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-ico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                </span>
                New Prep Workspace
            </a>
        </div>
    }

    <nav class="cd-sidebar__nav" aria-label="Sidebar navigation">
        <details class="cd-sidebar__group" open>
            <summary class="cd-sidebar__sectionLabel">Prep Workspace</summary>

            <a class="cd-sidebar__link @(currentController == "Dashboard" ? "is-active" : "")" asp-controller="Dashboard"
                asp-action="Index">
            <span class="cd-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 13h8V3H3v10z"></path>
                    <path d="M13 21h8V11h-8v10z"></path>
                    <path d="M13 3h8v6h-8V3z"></path>
                    <path d="M3 21h8v-6H3v6z"></path>
                </svg>
            </span>
            <span class="cd-sidebar__text">Prep Dashboard</span>
            </a>
        </details>

        <details class="cd-sidebar__group" open>
            <summary class="cd-sidebar__sectionLabel">Execution</summary>

            <a class="cd-sidebar__link @(currentController == "Strategies" ? "is-active" : "")" asp-controller="Strategies"
                asp-action="Index">
            <span class="cd-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18h6"></path>
                    <path d="M10 22h4"></path>
                    <path d="M12 2a7 7 0 0 0-4 12c.6.5 1 1.2 1 2h6c0-.8.4-1.5 1-2a7 7 0 0 0-4-12z"></path>
                </svg>
            </span>
            <span class="cd-sidebar__text">Strategies</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Actions" ? "is-active" : "")" asp-controller="Actions"
                asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">Actions</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Habits" ? "is-active" : "")" asp-controller="Habits"
                asp-action="Index"><span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2s4 4 4 9a4 4 0 0 1-8 0c0-5 4-9 4-9z"></path>
                        <path d="M8.5 14.5s-1.5 1.5-1.5 3.5a5 5 0 0 0 10 0c0-2-1.5-3.5-1.5-3.5"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">Habits</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Metrics" ? "is-active" : "")" asp-controller="Metrics"
                asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3v18h18"></path>
                        <path d="M7 14l3-3 4 4 6-7"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">Metrics</span>
            </a>

            <div class="cd-sidebar__divider"></div>

            <a class="cd-sidebar__link @(currentController == "StudyPlanner" ? "is-active" : "")" asp-controller="StudyPlanner"
               asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">📅</span>
                <span class="cd-sidebar__text">Study Planner</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Recommendations" ? "is-active" : "")" asp-controller="Recommendations"
               asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">✨</span>
                <span class="cd-sidebar__text">AI Recommendations</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Gamification" ? "is-active" : "")" asp-controller="Gamification"
               asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">🏅</span>
                <span class="cd-sidebar__text">Rewards</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Exports" ? "is-active" : "")" asp-controller="Exports"
               asp-action="CompetencySummaryPdf">
                <span class="cd-sidebar__icon" aria-hidden="true">📄</span>
                <span class="cd-sidebar__text">Export PDF</span>
            </a>
        </details>

        <details class="cd-sidebar__group" open>
            <summary class="cd-sidebar__sectionLabel">Intelligence</summary>

            <a class="cd-sidebar__link @(currentController == "WebsiteAnalysis" ? "is-active" : "")"
                asp-controller="WebsiteAnalysis" asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 21l-4.3-4.3"></path>
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="M11 8v6"></path>
                        <path d="M8 11h6"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">Resource Analysis</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "WarRoom" ? "is-active" : "")" asp-controller="WarRoom"
                asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l8 4v6c0 5-3.5 9.5-8 10-4.5-.5-8-5-8-10V6l8-4z"></path>
                        <path d="M12 8v6"></path>
                        <path d="M12 18h.01"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">War Room</span>
            </a>
        </details>

        <details class="cd-sidebar__group" open>
            <summary class="cd-sidebar__sectionLabel">AI</summary>

            <a class="cd-sidebar__link @(currentController == "StrategyCopilot" ? "is-active" : "")" asp-controller="StrategyCopilot"
                asp-action="Index">
            <span class="cd-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a7 7 0 0 0-4 12c.6.5 1 1.2 1 2h6c0-.8.4-1.5 1-2a7 7 0 0 0-4-12z"></path>
                    <path d="M8.5 18.5h7"></path>
                    <path d="M10 22h4"></path>
                </svg>
            </span>
            <span class="cd-sidebar__text">AI Study Co-Pilot</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "BusinessAnalysis" ? "is-active" : "")" asp-controller="BusinessAnalysis"
               asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3v18h18"></path>
                        <path d="M7 13h3v5H7z"></path>
                        <path d="M12 9h3v9h-3z"></path>
                        <path d="M17 5h3v13h-3z"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">Business Analysis</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "AiHistory" ? "is-active" : "")" asp-controller="AiHistory"
                asp-action="Index">
            <span class="cd-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 8v5l3 3"></path>
                    <path d="M3 12a9 9 0 1 0 9-9"></path>
                    <path d="M3 5v7h7"></path>
                </svg>
            </span>
            <span class="cd-sidebar__text">AI History</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "AiInsights" ? "is-active" : "")" asp-controller="AiInsights"
                asp-action="Index">
            <span class="cd-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18"></path>
                    <path d="M7 14l3-3 3 2 5-6"></path>
                    <path d="M7 21V14"></path>
                    <path d="M10 21V11"></path>
                    <path d="M13 21V13"></path>
                    <path d="M18 21V7"></path>
                </svg>
            </span>
            <span class="cd-sidebar__text">AI Insights</span>
            </a>
        </details>

        @if (User?.IsInRole("Admin") == true)
        {
            <div class="cd-sidebar__sectionLabel">Admin</div>
            <a class="cd-sidebar__link @(currentController == "Admin" ? "is-active" : "")" asp-controller="Admin"
                asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 1l3 5 6 .9-4.3 4.2 1 6-5.7-3-5.7 3 1-6L3 6.9 9 6l3-5z"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">Dashboard</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Admin" && currentAction == "Users" ? "is-active" : "")" asp-controller="Admin"
               asp-action="Users">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">User Roles</span>
            </a>

            <a class="cd-sidebar__link @(currentController == "Activity" ? "is-active" : "")" asp-controller="Activity"
               asp-action="Index">
                <span class="cd-sidebar__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 8v5l3 3"></path>
                        <path d="M3 12a9 9 0 1 0 9-9"></path>
                        <path d="M3 5v7h7"></path>
                    </svg>
                </span>
                <span class="cd-sidebar__text">Activity Log</span>
            </a>
        }

        @* Non-admin users can still view their own activity log *@
        @if (User?.Identity?.IsAuthenticated == true && User?.IsInRole("Admin") != true)
        {
            <details class="cd-sidebar__group" open>
                <summary class="cd-sidebar__sectionLabel">Security</summary>
                <a class="cd-sidebar__link @(currentController == "Activity" ? "is-active" : "")" asp-controller="Activity"
                   asp-action="Index">
                    <span class="cd-sidebar__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 8v5l3 3"></path>
                            <path d="M3 12a9 9 0 1 0 9-9"></path>
                            <path d="M3 5v7h7"></path>
                        </svg>
                    </span>
                    <span class="cd-sidebar__text">My Activity</span>
                </a>
            </details>
        }

        <a class="cd-sidebar__link @(currentController == "Settings" ? "is-active" : "")" asp-controller="Settings" asp-action="Index">
            <span class="cd-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-navico" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"></path>
                    <path
                        d="M19.4 15a7.9 7.9 0 0 0 .1-1 7.9 7.9 0 0 0-.1-1l2-1.5-2-3.5-2.3.7a8 8 0 0 0-1.7-1L15 3h-6l-.4 2.7a8 8 0 0 0-1.7 1L4.6 6l-2 3.5 2 1.5a8.7 8.7 0 0 0 0 2l-2 1.5 2 3.5 2.3-.7a8 8 0 0 0 1.7 1L9 21h6l.4-2.7a8 8 0 0 0 1.7-1l2.3.7 2-3.5-2-1.5z">
                    </path>
                </svg>
            </span>
            <span class="cd-sidebar__text">Settings</span>
        </a>
    </nav>

    <div class="cd-sidebar__bottom">
        @* <div class="cd-sidebar__user">
            <div class="cd-sidebar__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="cd-avat" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21a8 8 0 0 0-16 0"></path>
                    <circle cx="12" cy="8" r="4"></circle>
                </svg>
            </div>

            <div class="cd-sidebar__userMeta">
                <div class="cd-sidebar__userName">@displayName</div>
                <div class="cd-sidebar__userEmail">@email</div>
            </div>
        </div> *@

        <div class="cd-sidebar__auth">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit" class="cd-btn cd-btn--ghost cd-btn--block">Logout</button>
                </form>
            }
            else
            {
                <a class="cd-btn cd-btn--ghost cd-btn--block" asp-area="Identity" asp-page="/Account/Login">Login</a>
            }
        </div>

        <div class="cd-sidebar__footer">
            <span>&copy; @DateTime.Now.Year - CompeteDesk - </span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </div>
</aside>