@model CompeteDesk.Models.Strategy

<div class="cd-formGrid">
    <div class="cd-field">
        <div class="form-floating">
            <input asp-for="Name" class="form-control cd-input" placeholder="Strategy name" />
            <label asp-for="Name" class="cd-required"></label>
        </div>
        <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
    </div>

    <div class="cd-field">
        <div class="form-floating">
            <select asp-for="StrategyType" class="form-select cd-input">
            <option value="Offensive">Offensive</option>
            <option value="Defensive">Defensive</option>
            <option value="Growth">Growth</option>
            <option value="Stability">Stability</option>
            </select>
            <label asp-for="StrategyType" class="cd-required">Strategy Type</label>
        </div>
        <div class="cd-help">Used in the Strategy Command Header for fast readiness awareness.</div>
        <span asp-validation-for="StrategyType" class="invalid-feedback d-block"></span>
    </div>

    <div class="cd-field">
        <div class="form-floating">
            <input asp-for="Category" class="form-control cd-input" placeholder="Category" />
            <label asp-for="Category"></label>
        </div>
        <span asp-validation-for="Category" class="invalid-feedback d-block"></span>
    </div>

    <div class="cd-field">
        <div class="form-floating">
            <select asp-for="Status" class="form-select cd-input">
            <option value="Active">Active</option>
            <option value="Archived">Archived</option>
            </select>
            <label asp-for="Status" class="cd-required"></label>
        </div>
        <span asp-validation-for="Status" class="invalid-feedback d-block"></span>
    </div>

    <div class="cd-field">
        <div class="form-floating">
            <input asp-for="Priority" type="number" class="form-control cd-input" placeholder="Priority" />
            <label asp-for="Priority"></label>
        </div>
        <div class="cd-help">Higher priority appears first.</div>
        <span asp-validation-for="Priority" class="invalid-feedback d-block"></span>
    </div>

    <div class="cd-field cd-field--full">
        <div class="form-floating">
            <input asp-for="CorePrinciple" class="form-control cd-input" placeholder="Core principle" />
            <label asp-for="CorePrinciple"></label>
        </div>
        <span asp-validation-for="CorePrinciple" class="invalid-feedback d-block"></span>
    </div>

    <div class="cd-field cd-field--full">
        <div class="form-floating">
            <textarea asp-for="Summary" class="form-control cd-input" style="height: 140px" placeholder="Summary"></textarea>
            <label asp-for="Summary"></label>
        </div>
        <span asp-validation-for="Summary" class="invalid-feedback d-block"></span>
    </div>

    <div class="cd-field cd-field--full">
        <div class="form-floating">
            <input asp-for="SourceBook" class="form-control cd-input" placeholder="Source book" />
            <label asp-for="SourceBook"></label>
        </div>
        <span asp-validation-for="SourceBook" class="invalid-feedback d-block"></span>
    </div>
</div>