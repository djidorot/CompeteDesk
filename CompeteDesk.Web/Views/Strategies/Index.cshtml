@model List<CompeteDesk.Models.Strategy>
@{
    ViewData["Title"] = "Strategies";
    ViewData["LayoutFluid"] = true;
    ViewData["UseSidebar"] = true;

    var q = (string)(ViewBag.Query ?? "");
    var status = (string)(ViewBag.Status ?? "");
    var workspaceId = (int?)(ViewBag.WorkspaceId ?? null);
    var sort = (string)(ViewBag.Sort ?? "priority");
    var tag = (string)(ViewBag.Tag ?? "");
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count);
}

<link rel="stylesheet" href="~/css/strategies.css" asp-append-version="true" />

<div class="cd-strategies">
    <div class="cd-strategies__head card shadow-sm">
        <div class="card-body cd-strategies__headBody">
            <div class="cd-strategies__headLeft">
                <h1 class="cd-h1 mb-1">Strategies</h1>
                <div class="cd-sub">Create, track, and refine your plays for your workspace.</div>
            </div>

            <div class="cd-strategies__headRight">
                <a class="btn btn-primary cd-btn" asp-action="Create">+ New Strategy</a>
            </div>
        </div>

        <div class="card-body pt-0">
            <div class="cd-strategies__filters">
                <form method="get" class="cd-strategies__filterRow" role="search">
                    <div class="cd-field">
                        <label class="cd-label" for="q">Search</label>
                        <input id="q" name="q" class="form-control cd-input" value="@q" placeholder="Search name, principle, category…" />
                    </div>

                    <div class="cd-field">
                        <label class="cd-label" for="status">Status</label>
                        <select id="status" name="status" class="form-select cd-input">
                            <option value="" selected="@(string.IsNullOrEmpty(status))">All</option>
                            <option value="Draft" selected="@(status == "Draft")">Draft</option>
                            <option value="Active" selected="@(status == "Active")">Active</option>
                            <option value="Completed" selected="@(status == "Completed")">Completed</option>
                            <option value="Archived" selected="@(status == "Archived")">Archived</option>
                        </select>
                    </div>

                    <div class="cd-field">
                        <label class="cd-label" for="workspaceId">Workspace</label>
                        <select id="workspaceId" name="workspaceId" class="form-select cd-input" asp-items="ViewBag.Workspaces">
                            <option value="">All</option>
                        </select>
                    </div>

                    <div class="cd-field">
                        <label class="cd-label" for="tag">Tag</label>
                        <input id="tag" name="tag" class="form-control cd-input" value="@tag" placeholder="e.g. SEO, Launch" />
                    </div>

                    <div class="cd-field">
                        <label class="cd-label" for="sort">Sort</label>
                        <select id="sort" name="sort" class="form-select cd-input">
                            <option value="priority" selected="@(sort == "priority")">Priority</option>
                            <option value="newest" selected="@(sort == "newest")">Newest</option>
                            <option value="alpha" selected="@(sort == "alpha")">A → Z</option>
                        </select>
                    </div>

                    <div class="cd-field cd-field--actions">
                        <label class="cd-label" aria-hidden="true">&nbsp;</label>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary cd-btn" type="submit">Filter</button>
                            <a class="btn btn-outline-secondary cd-btn" asp-action="Index">Reset</a>
                        </div>
                    </div>
                </form>

                @if (totalCount == 0 && status == "Active")
                {
                    <div class="cd-seed card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="cd-seed__title">No strategies yet.</div>
                            <div class="cd-seed__sub mb-3">You can create your own — or seed the 33 strategy titles as a starting point.</div>
                            <form asp-action="SeedFromBook" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-primary cd-btn" type="submit">Seed from book</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="position-relative" data-async-pager>
        <div class="cd-loading-overlay" data-loading-overlay>
            <div class="cd-skeleton" style="width: min(520px, 90%); padding: 16px;">
                <div class="cd-skeleton cd-skeleton-line lg"></div>
                <div class="cd-skeleton cd-skeleton-line"></div>
                <div class="cd-skeleton cd-skeleton-line"></div>
                <div class="cd-skeleton cd-skeleton-line"></div>
            </div>
        </div>
        <div data-async-body>
            @await Html.PartialAsync("_StrategiesList", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/strategies.js" asp-append-version="true"></script>
}
