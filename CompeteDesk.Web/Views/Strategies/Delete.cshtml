@model CompeteDesk.Models.Strategy
@{
    ViewData["Title"] = "Delete Strategy";
    ViewData["LayoutFluid"] = true;
    ViewData["UseSidebar"] = true;
}

<link rel="stylesheet" href="~/css/strategies.css" asp-append-version="true" />

<div class="cd-page">
    <div class="cd-page__head">
        <a class="cd-link" asp-action="Index">← Back to Strategies</a>
        <h1 class="cd-h1 mb-1">Delete Strategy</h1>
        <div class="cd-sub">This action cannot be undone.</div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="alert alert-warning mb-3">
                Are you sure you want to delete <strong>@Model.Name</strong>?
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="cd-formActions">
                    <button type="button" class="btn btn-danger cd-btn" data-bs-toggle="modal" data-bs-target="#cdConfirmDelete">Delete</button>
                    <a class="btn btn-outline-secondary cd-btn" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                </div>

                <div class="modal fade" id="cdConfirmDelete" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Confirm delete</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Delete <strong>@Model.Name</strong>? This can’t be undone.
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button class="btn btn-danger" type="submit">Yes, delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>