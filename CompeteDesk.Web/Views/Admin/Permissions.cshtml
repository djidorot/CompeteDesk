@model CompeteDesk.ViewModels.Admin.AdminPermissionsViewModel

@{
    ViewData["Title"] = "Feature Permissions";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h4 mb-1">Feature Permissions</h1>
        <div class="text-muted">Manage feature access for <strong>@(Model.Email ?? Model.UserName ?? Model.UserId)</strong>.</div>
    </div>
    <div class="d-flex gap-2">
        <span class="badge text-bg-light border">Role: @Model.Role</span>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Admin" asp-action="Users">Back to Users</a>
    </div>
</div>

<form asp-controller="Admin" asp-action="SavePermissions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" value="@Model.UserId" />

    <div class="row g-3">
        @for (var i = 0; i < Model.Groups.Count; i++)
        {
            var group = Model.Groups[i];
            <div class="col-12 col-xl-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                            <h2 class="h6 mb-0">@group.Name</h2>
                            <span class="text-muted small">@group.Permissions.Count permissions</span>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var permission in group.Permissions)
                            {
                                <label class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                                    <input class="form-check-input mt-1" type="checkbox" name="grantedPermissions" value="@permission.Key" checked="@permission.IsGranted" />
                                    <span>
                                        <span class="fw-semibold d-block">@permission.FeatureName</span>
                                        <span class="text-muted small d-block">@permission.Description</span>
                                        <code class="small">@permission.Key</code>
                                    </span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button class="btn btn-primary" type="submit">Save permissions</button>
    </div>
</form>
