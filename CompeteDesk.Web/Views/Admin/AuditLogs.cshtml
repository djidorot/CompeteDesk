@model IReadOnlyList<CompeteDesk.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    ViewData["LayoutFluid"] = true;
    ViewData["UseSidebar"] = true;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Audit Logs</h1>
            <p class="text-muted mb-0">Admin view of login activity, exports, and data changes.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to Admin</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>User</th>
                        <th>Summary</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy • h:mm tt")</td>
                        <td>@item.Action</td>
                        <td>@(string.IsNullOrWhiteSpace(item.EntityType) ? "—" : $"{item.EntityType} #{item.EntityId}")</td>
                        <td>@(item.ActorEmail ?? item.ActorUserId ?? "System")</td>
                        <td>@item.Summary</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
