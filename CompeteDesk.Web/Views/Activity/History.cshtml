@model CompeteDesk.ViewModels.Activity.EntityHistoryViewModel

@{
    ViewData["Title"] = "Change History";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h4 mb-0">Change History</h1>
        <div class="text-muted">@Model.Title</div>
    </div>
    <a class="btn btn-sm btn-outline-secondary" asp-controller="Activity" asp-action="Index">Back to Activity</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="position-relative" data-async-pager>
            <div class="cd-loading-overlay" data-loading-overlay>
                <div class="cd-skeleton" style="width: min(520px, 90%); padding: 16px;">
                    <div class="cd-skeleton cd-skeleton-line lg"></div>
                    <div class="cd-skeleton cd-skeleton-line"></div>
                    <div class="cd-skeleton cd-skeleton-line"></div>
                    <div class="cd-skeleton cd-skeleton-line"></div>
                </div>
            </div>
            <div data-async-body>
                @await Html.PartialAsync("_EntityHistoryTable", Model)
            </div>
        </div>
    </div>
</div>
