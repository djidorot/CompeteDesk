@model CompeteDesk.ViewModels.Activity.EntityHistoryViewModel

@{
    ViewData["Title"] = "Change History";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h4 mb-0">Change History</h1>
        <div class="text-muted">@Model.Title</div>
    </div>
    <a class="btn btn-sm btn-outline-secondary" asp-controller="Activity" asp-action="Index">Back to Activity</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <div class="text-muted">No history found for this item.</div>
        }
        else
        {
            @foreach (var h in Model.Items)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <span class="badge text-bg-light">@h.Action</span>
                        <span class="text-muted">@h.ChangedAtUtc.ToString("yyyy-MM-dd HH:mm") (UTC)</span>
                        <span class="text-muted">•</span>
                        <span class="text-muted">@h.ActorEmail</span>
                    </div>

                    <details class="mb-2">
                        <summary>After</summary>
                        <pre class="small bg-light p-2 rounded mb-0" style="white-space:pre-wrap;">@h.AfterJson</pre>
                    </details>

                    <details>
                        <summary>Before</summary>
                        <pre class="small bg-light p-2 rounded mb-0" style="white-space:pre-wrap;">@h.BeforeJson</pre>
                    </details>
                </div>
            }
        }
    </div>
</div>
