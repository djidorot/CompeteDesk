@model IReadOnlyList<CompeteDesk.Models.NotificationItem>
@{
    ViewData["Title"] = "Notifications";
    ViewData["UseSidebar"] = true;
    ViewData["LayoutFluid"] = true;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Notifications</h1>
            <p class="text-muted mb-0">Updates, reminders, and workspace activity.</p>
        </div>
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary">Mark all as read</button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0"><div class="card-body p-4 text-muted">No notifications yet.</div></div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var item in Model)
            {
                <div class="card shadow-sm border-0 @(item.IsRead ? "" : "border-start border-4 border-primary")">
                    <div class="card-body d-flex justify-content-between gap-3 align-items-start">
                        <div>
                            <div class="small text-uppercase text-muted fw-semibold mb-1">@item.Type</div>
                            <div class="fw-semibold mb-1">@item.Title</div>
                            <div class="text-muted mb-2">@item.Message</div>
                            <div class="small text-muted">@item.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy • h:mm tt")</div>
                            @if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                            {
                                <div class="mt-2"><a href="@item.LinkUrl">Open</a></div>
                            }
                        </div>
                        @if (!item.IsRead)
                        {
                            <form asp-action="MarkRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="/Notifications" />
                                <button class="btn btn-sm btn-outline-secondary">Mark read</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
