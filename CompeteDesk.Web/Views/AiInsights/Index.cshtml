@model CompeteDesk.ViewModels.AiInsights.AiInsightsViewModel
@{
    ViewData["Title"] = "AI Insights";
    ViewData["LayoutFluid"] = true;
    ViewData["UseSidebar"] = true;
}

<link rel="stylesheet" href="~/css/ai-insights.css" asp-append-version="true" />

<div class="cd-aii">
    <div class="cd-aii__head">
        <div>
            <h1 class="cd-aii__title">AI Insights</h1>
            <div class="cd-aii__sub">
                @if (Model.WorkspaceId.HasValue)
                {
                    <span>Workspace: <strong>@(Model.WorkspaceName ?? $"#{Model.WorkspaceId}")</strong></span>
                }
                else
                {
                    <span>All workspaces</span>
                }
                <span class="cd-aii__dot">•</span>
                <span>Performance, weak areas, and recommended focus.</span>
            </div>
        </div>
        <div class="cd-aii__headActions">
            <a class="btn btn-primary cd-aii__btn" asp-controller="StrategyCopilot" asp-action="Index">Open Strategy Co-Pilot</a>
            <a class="btn btn-outline-secondary cd-aii__btn" asp-controller="AiHistory" asp-action="Index">View AI History</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <section class="cd-aii__card h-100">
                <header class="cd-aii__cardHead">
                    <div>
                        <div class="cd-aii__cardTitle">AI Performance Analysis</div>
                        <div class="cd-aii__muted">Recent AI usage + readiness signals.</div>
                    </div>
                    <span class="cd-aii__pill">Last 30 days</span>
                </header>

                <div class="cd-aii__cardBody">
                    <div class="cd-aii__stats">
                        <div class="cd-aii__stat">
                            <div class="cd-aii__statLabel">AI traces (7d)</div>
                            <div class="cd-aii__statValue">@Model.Performance.TracesLast7Days</div>
                        </div>
                        <div class="cd-aii__stat">
                            <div class="cd-aii__statLabel">AI traces (30d)</div>
                            <div class="cd-aii__statValue">@Model.Performance.TracesLast30Days</div>
                        </div>
                        <div class="cd-aii__stat">
                            <div class="cd-aii__statLabel">Last AI run</div>
                            <div class="cd-aii__statValue cd-aii__statValue--small">
                                @(Model.Performance.LastTraceAtUtc.HasValue ? Model.Performance.LastTraceAtUtc.Value.ToLocalTime().ToString("MMM d, yyyy • h:mm tt") : "—")
                            </div>
                        </div>
                    </div>

                    <div class="cd-aii__divider"></div>

                    <div class="cd-aii__kv">
                        <div class="cd-aii__kvRow">
                            <div class="cd-aii__kvK">Strategies w/ playbook</div>
                            <div class="cd-aii__kvV">@Model.Performance.StrategiesWithPlaybook / @Model.Performance.StrategiesTotal</div>
                        </div>
                        <div class="cd-aii__kvRow">
                            <div class="cd-aii__kvK">Open actions</div>
                            <div class="cd-aii__kvV">@Model.Performance.ActionsOpen</div>
                        </div>
                        <div class="cd-aii__kvRow">
                            <div class="cd-aii__kvK">Done (last 14d)</div>
                            <div class="cd-aii__kvV">@Model.Performance.ActionsDoneLast14Days</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="cd-aii__card h-100">
                <header class="cd-aii__cardHead">
                    <div>
                        <div class="cd-aii__cardTitle">Weak Area Detection</div>
                        <div class="cd-aii__muted">Heuristic alerts based on your saved data.</div>
                    </div>
                    <span class="cd-aii__pill cd-aii__pill--warn">Alerts</span>
                </header>

                <div class="cd-aii__cardBody">
                    @if (Model.WeakAreas.Count == 0)
                    {
                        <div class="cd-aii__empty">
                            <div class="cd-aii__emptyTitle">No obvious weak areas detected.</div>
                            <div class="cd-aii__muted">Keep building momentum—your signals look stable.</div>
                        </div>
                    }
                    else
                    {
                        <ul class="cd-aii__list">
                            @foreach (var item in Model.WeakAreas)
                            {
                                <li class="cd-aii__listItem">
                                    <div class="cd-aii__listTitle">@item.Title</div>
                                    <div class="cd-aii__muted">@item.Detail</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Href))
                                    {
                                        <a class="cd-aii__link" href="@item.Href">Open →</a>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="cd-aii__card h-100">
                <header class="cd-aii__cardHead">
                    <div>
                        <div class="cd-aii__cardTitle">Recommended Focus Areas</div>
                        <div class="cd-aii__muted">Next best actions to increase signal and execution.</div>
                    </div>
                    <span class="cd-aii__pill cd-aii__pill--good">Next</span>
                </header>

                <div class="cd-aii__cardBody">
                    <ul class="cd-aii__list">
                        @foreach (var item in Model.Recommendations)
                        {
                            <li class="cd-aii__listItem">
                                <div class="cd-aii__listTitle">@item.Title</div>
                                <div class="cd-aii__muted">@item.Detail</div>
                                @if (!string.IsNullOrWhiteSpace(item.Href))
                                {
                                    <a class="cd-aii__link" href="@item.Href">Open →</a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </section>
        </div>
    </div>

    <section class="cd-aii__card cd-aii__card--wide mt-3">
        <header class="cd-aii__cardHead">
            <div>
                <div class="cd-aii__cardTitle">Feature usage</div>
                <div class="cd-aii__muted">Where AI is being used inside CompeteDesk (last 30 days).</div>
            </div>
            <a class="cd-aii__link" asp-controller="AiHistory" asp-action="Index">See all traces →</a>
        </header>

        <div class="cd-aii__cardBody">
            @if (Model.FeatureUsage.Count == 0)
            {
                <div class="cd-aii__empty">
                    <div class="cd-aii__emptyTitle">No AI traces yet.</div>
                    <div class="cd-aii__muted">Use any AI button (Search, Playbook, Assist) to start building history.</div>
                </div>
            }
            else
            {
                <div class="table-responsive cd-aii__tableWrap">
                    <table class="table table-sm align-middle mb-0 cd-aii__table">
                        <thead>
                            <tr>
                                <th>Feature</th>
                                <th style="width:140px">Uses (30d)</th>
                                <th style="width:120px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.FeatureUsage)
                            {
                                <tr>
                                    <td class="cd-aii__tdFeature">@row.Feature</td>
                                    <td><span class="cd-aii__count">@row.Count30Days</span></td>
                                    <td>
                                        <a class="cd-aii__link" href="/AiHistory?feature=@Uri.EscapeDataString(row.Feature)">View →</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
