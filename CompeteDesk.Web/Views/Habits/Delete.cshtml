@model CompeteDesk.Models.Habit

@{
    ViewData["Title"] = "Delete Habit";
}

@section Styles {
    <link rel="stylesheet" href="~/css/habits.css" asp-append-version="true" />
}

<div class="cd-page habits-page">
    <div class="cd-page__header">
        <div>
            <h1 class="cd-h1 mb-1">Delete Habit</h1>
            <p class="cd-muted mb-0">This will remove the habit and its check-ins.</p>
        </div>
    </div>

    <div class="cd-card mt-4">
        <div class="cd-card__body">
            <div class="cd-note">
                Are you sure you want to delete <strong>@Model.Title</strong>?
            </div>

            <form method="post" asp-action="Delete" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button class="btn btn-danger cd-btn" type="button" data-bs-toggle="modal" data-bs-target="#cdConfirmDelete">Delete</button>
                    <a class="btn btn-outline-secondary cd-btn" asp-action="Index" asp-route-workspaceId="@Model.WorkspaceId">Cancel</a>
                </div>

                <div class="modal fade" id="cdConfirmDelete" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Confirm delete</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Delete <strong>@Model.Title</strong>? This can’t be undone.
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button class="btn btn-danger" type="submit">Yes, delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
